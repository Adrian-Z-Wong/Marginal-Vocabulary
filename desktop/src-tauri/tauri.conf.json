{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Marginal Vocabulary",
  "version": "0.6.3",
  "identifier": "io.github.adrian-z-wong.margin",
  "build": {
    "frontendDist": "../www"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Marginal Vocabulary",
        "width": 1100,
        "height": 820,
        "minWidth": 760,
        "minHeight": 620,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Education",
    "shortDescription": "背单词、学词根的小工具",
    "copyright": "© 2026 Adrian-Z-Wong",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": false,
        "installMode": "currentUser"
      }
    }
  }
}
